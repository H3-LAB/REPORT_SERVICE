# URL do REPORT SERVICE (com o prefixo, se tiver) e o token do agente (Administração → Agentes)
REPORT_SERVICE_URL=https://<servidor>/report-service
AGENT_TOKEN=rta_...

# Nome da máquina, mostrado em Administração → Agentes
AGENT_HOSTNAME=zproxy15

# Scripts (Python/shell) definidos na app: só se este agente os puder correr
ALLOW_SCRIPTS=false

# Proxy de saída, se a máquina não chega diretamente à app
HTTPS_PROXY=
NO_PROXY=

# CA interna (montada no compose) ou, só em testes, VERIFY_TLS=false
CA_BUNDLE=

# Opcionais
POLL_SECONDS=15
QUERY_TIMEOUT=900
SCRIPT_TIMEOUT=1800
