# Servidor do REPORT SERVICE: porta dos agentes (10050, HTTPS) e o IP para onde aponta o nome
REPORT_SERVICE_URL=https://report-service.corp.multicert.com:10050
REPORT_SERVICE_IP=<ip do servidor>
# Token do agente (Administração → Agentes)
AGENT_TOKEN=rta_...

# Nome da máquina, mostrado em Administração → Agentes
AGENT_HOSTNAME=zproxy15

# Scripts (Python/shell) definidos na app: só se este agente os puder correr
ALLOW_SCRIPTS=false

# Proxy de saída: a ligação ao servidor é direta (o proxy não conhece o nome), por isso fica no NO_PROXY
HTTPS_PROXY=
NO_PROXY=report-service.corp.multicert.com

# Só com certificado de CA interna (montada no compose). O da Sectigo já é reconhecido.
CA_BUNDLE=

# Opcionais
POLL_SECONDS=15
QUERY_TIMEOUT=900
SCRIPT_TIMEOUT=1800
