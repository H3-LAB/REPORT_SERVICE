# ===== Base de dados =====
POSTGRES_PASSWORD=<password forte>

# ===== Segredos =====
# Assina a sessão: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Cifra tokens e passwords das fontes e canais na base de dados. NÃO a perca nem a mude:
# sem ela os segredos guardados ficam ilegíveis.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ===== Keycloak =====
KEYCLOAK_URL=https://<keycloak>
KEYCLOAK_REALM=<realm>
KEYCLOAK_CLIENT_ID=REPORT_SERVICE
KEYCLOAK_CLIENT_SECRET=
# Grupos: <raiz>/ADMIN, <raiz>/OPERADOR e, opcionalmente, <raiz>/<EQUIPA>.
# O client precisa do mapper "Group Membership" (claim "groups", Full group path).
KEYCLOAK_GROUP_ROOT=/REPORTING_CORP

# ===== App =====
REPORT_SERVICE_VERSION=1.1.4
REPORT_SERVICE_PORT=8090
# Prefixo do URL atrás do nginx (ex. /report-service); vazio se a app está na raiz
URL_PREFIX=
APP_TIMEZONE=Europe/Lisbon
# Porta HTTPS só para os agentes (contentor agent-api; certificado em certs/)
AGENT_API_PORT=10050
# URL e IP que os agentes usam (aparecem no .env mostrado ao criar um agente)
AGENT_API_URL=https://report-service.corp.multicert.com:10050
AGENT_API_IP=
# Painéis renderizados ao mesmo tempo no Grafana
RENDER_CONCURRENCY=2
# Só em desenvolvimento: entra um admin local sem Keycloak
AUTH_DISABLED=0
